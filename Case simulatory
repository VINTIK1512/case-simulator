async function toggleAuto(){
  if(autoOpenActive){autoOpenActive=false;document.getElementById("autoBtn").classList.remove("active");document.getElementById("autoBtn").textContent="🔁 Авто до легендарки";return}
  autoOpenActive=true;document.getElementById("autoBtn").classList.add("active");document.getElementById("autoBtn").textContent="⏹️ Стоп";
  const c=CASES[selectedCase];if(c.goldOnly && !state.goldPass){showToast("🔒 Голд Пасс!");autoOpenActive=false;return}
  const price=getCasePrice(selectedCase);
  if(price===0){showToast("❌ Бесплатный не для авто");autoOpenActive=false;document.getElementById("autoBtn").classList.remove("active");document.getElementById("autoBtn").textContent="🔁 Авто до легендарки";return}
  let count=0;
  while(autoOpenActive && state.balance>=price){
    if(state.tasks.length===0)initDailyTasks();
    state.balance-=price;state.opened++;count++;addXP(state.goldPass?15:10);
    trackTask("open5",1);trackTask("open20",1);trackQuest("open10");
    if(price>0)trackTask("spend1000",price);
    const w=pickItemWithPity(c);
    state.inventory.push({...w,uid:Date.now()+Math.random()});
    markRarity(w.rarity,w.name);addHistory(w,c.name);
    if(RARITY_CHANCE[w.rarity]<2)state.pity++;else state.pity=0;
    updateUI();save();
    if(RARITY_CHANCE[w.rarity]>=3){
      showToast(`🎉 Авто стоп! ${w.name}`);playWin(w.rarity);autoOpenActive=false;
      document.getElementById("autoBtn").classList.remove("active");document.getElementById("autoBtn").textContent="🔁 Авто до легендарки";
      document.getElementById("result").textContent=`✨ ${w.name} за ${count}`;
      document.getElementById("result").style.color=getRarityColor(w.rarity);
      checkAchievements();return;
    }
    await new Promise(r=>setTimeout(r,50));
  }
  autoOpenActive=false;document.getElementById("autoBtn").classList.remove("active");document.getElementById("autoBtn").textContent="🔁 Авто до легендарки";
  updateUI();checkAchievements();
}


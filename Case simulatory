let tickInterval=null;
function startTicking(totalMs){
  let i=0;const total=110;const cycle=totalMs/110;
  function tick(){if(i>=total)return;const t=i/total;playTone(1400-t*500,.015,"square",.03);i++;tickInterval=setTimeout(tick,cycle*(.3+Math.pow(t,2)*2.5))}
  tick();
}
function stopTicking(){if(tickInterval){clearTimeout(tickInterval);tickInterval=null}}


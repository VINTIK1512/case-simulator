function trackQuest(track){
  if(state.questChainIdx>=QUEST_CHAIN.length)return;
  const q=QUEST_CHAIN[state.questChainIdx];if(q.track!==track)return;
  state.questChainProgress++;
  if(state.questChainProgress>=q.target){state.balance+=q.reward;showToast(`🎯 +${q.reward}`);state.questChainIdx++;state.questChainProgress=0}
  save();
}
function initDailyChallenge(){

}
function setButtonsDisabled(d){["openBtn","openX3","openX5","openX10","openBull"].forEach(id=>{const el=document.getElementById(id);if(el)el.disabled=d})}
function getSpinSpeed(){return SPIN_SPEEDS[state.settings.speed]||SPIN_SPEEDS.normal}

function spinRouletteOnce(c,winner,containerId="roulette"){
  return new Promise(res=>{
    const sp=getSpinSpeed();const TOTAL=70,WIN=62;
    const slots=[];for(let i=0;i<TOTAL;i++)slots.push(pickItem(c));
    slots[WIN]=winner;
    const rEl=document.getElementById(containerId);if(!rEl)return res();
    const container=rEl.closest(".roulette-container");if(!container)return res();
    rEl.innerHTML="";slots.forEach(it=>rEl.appendChild(createSlot(it)));
    rEl.style.transition="none";rEl.style.transform="translateX(0)";
    container.classList.add("spinning");
    const sw=80,cw=container.offsetWidth;
    const off=(Math.random()-.5)*(sw*.7);
    const tx=-(WIN*sw)-(sw/2)+(cw/2)+off;
    requestAnimationFrame(()=>setTimeout(()=>{rEl.style.transition=`transform ${sp.duration}ms cubic-bezier(.05,.7,.1,1)`;rEl.style.transform=`translateX(${tx}px)`},30));
    playSpin();startTicking(sp.duration);
    setTimeout(()=>{
      stopTicking();container.classList.remove("spinning");container.classList.add("win-flash");
      playWin(winner.rarity);
      const old=container.querySelector(".win-popup");if(old)old.remove();
      const p=document.createElement("div");p.className="win-popup rarity-"+winner.rarity;
      p.appendChild(createGunImage(winner,"gun-image"));
      const pt=document.createElement("div");pt.innerHTML=`${winner.name}<br><small>${winner.rarity}</small>`;p.appendChild(pt);
      container.appendChild(p);
      setTimeout(()=>{p.style.transition="opacity .3s";p.style.opacity="0";setTimeout(()=>p.remove(),300)},1300);
      setTimeout(()=>container.classList.remove("win-flash"),900);
      res();
    },sp.delay);
  });
}

async function openCase(){
  if(isSpinning)return;initAudio();
  const c=CASES[selectedCase];if(c.goldOnly && !state.goldPass){showToast("🔒 Голд Пасс!");return}
  const price=getCasePrice(selectedCase);
  if(state.balance<price){showToast("❌ Мало!");return}
  if(state.tasks.length===0)initDailyTasks();
  state.balance-=price;state.opened++;addXP(state.goldPass?15:10);
  addTransaction(`Открыл ${c.name}`,`-${price}`);
  markCaseOpened(selectedCase);
  trackTask("open5",1);trackTask("open20",1);trackQuest("open10");
  if(price>0)trackTask("spend1000",price);
  if(state.dailyChallenge&&state.dailyChallenge.id==="open10fast")trackChallenge(1);
  isSpinning=true;setButtonsDisabled(true);
  document.getElementById("result").textContent="";
  document.getElementById("multiProgress").textContent="";
  document.getElementById("multiHistory").innerHTML="";
  const w=pickItemWithPity(c);
  await spinRouletteOnce(c,w);
  state.inventory.push({...w,uid:Date.now()+Math.random()});
  markRarity(w.rarity,w.name);addHistory(w,c.name);
  if(RARITY_CHANCE[w.rarity]<2)state.pity++;else state.pity=0;
  if(w.rarity==="Редкий"){trackTask("rare1",1);trackQuest("rare1")}
  if(w.rarity==="Мифический"&&state.dailyChallenge&&state.dailyChallenge.id==="mythic")trackChallenge(1);
  document.getElementById("result").textContent=`✨ ${w.name} [${w.rarity}]`;
  document.getElementById("result").style.color=getRarityColor(w.rarity);
  updateUI();save();checkAchievements();
  isSpinning=false;setButtonsDisabled(false);
}


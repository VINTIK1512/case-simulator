function renderInventory(){
  renderInvFilters();
  const el=document.getElementById("inventory");if(!el)return;
  let items=state.inventory;
  if(state.invFilter!=="all")items=items.filter(i=>i.rarity===state.invFilter);
  items=[...items].sort((a,b)=>{const r=RARITY_CHANCE[b.rarity]-RARITY_CHANCE[a.rarity];return r!==0?r:b.price-a.price});
  if(items.length===0){el.innerHTML='<p class="inventory-empty">🎒 Пусто</p>';document.getElementById("sellAllBtn").style.display=state.inventory.length===0?"none":"block";return}
  document.getElementById("sellAllBtn").style.display="block";el.innerHTML="";
  items.forEach(it=>{
    const d=document.createElement("div");d.className="inv-item rarity-"+it.rarity;
    const nw=document.createElement("span");nw.className="inv-name";
    nw.appendChild(createGunImage(it,"inv-img"));

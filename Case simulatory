function trackChallenge(a=1){
  if(!state.dailyChallenge)return;
  state.dailyChallenge.progress=Math.min(state.dailyChallenge.target,state.dailyChallenge.progress+a);
  if(state.dailyChallenge.progress>=state.dailyChallenge.target){state.balance+=state.dailyChallenge.reward;showToast(`🔥 +${state.dailyChallenge.reward}`);state.dailyChallenge=null}
  save();
}

function pickItemWithPity(c){
  const limit=state.goldPass?40:PITY_LIMIT;const mult=isGoldHour()?2:1;
  if(state.pity>=limit){
    const rp=c.items.filter(i=>RARITY_CHANCE[i.rarity]>=2);
    if(rp.length>0){
      const total=rp.reduce((s,i)=>s+i.chance*mult,0);let r=Math.random()*total;
      for(const item of rp){r-=item.chance*mult;if(r<=0){state.pity=0;return item}}
      state.pity=0;return rp[0];
    }
  }
  return pickItem(c);
}
function pickItem(c){
  const mult=isGoldHour()?2:1;
  const weighted=c.items.map(i=>{const isRare=RARITY_CHANCE[i.rarity]>=2;return{...i,chance:i.chance*(isRare?mult:1)}});
  const total=weighted.reduce((s,i)=>s+i.chance,0);let r=Math.random()*total;
  for(const item of weighted){r-=item.chance;if(r<=0)return item}
  return weighted[0];
}

function createGunImage(item,className){
  const w=document.createElement("div");w.className=className;
  if(item.img && item.img.startsWith("http")){
    const im=document.createElement("img");im.src=item.img;im.alt=item.name;im.loading="lazy";
    im.onerror=()=>{w.innerHTML=`<span class="gun-emoji">${item.emoji||"🔫"}</span>`};
    w.appendChild(im);
  }else w.innerHTML=`<span class="gun-emoji">${item.emoji||"🔫"}</span>`;
  return w;
}
function createSlot(item){
  const s=document.createElement("div");s.className="slot rarity-"+item.rarity;
  s.appendChild(createGunImage(item,"gun-image"));
  const n=document.createElement("div");n.className="name";n.textContent=item.name;s.appendChild(n);
  const r=document.createElement("div");r.className="rarity-label";r.textContent=item.rarity;s.appendChild(r);
  return s;
}
function createBullSlot(item){
  const s=document.createElement("div");s.className="bull-slot rarity-"+item.rarity;
  if(item.img){const im=document.createElement("img");im.src=item.img;im.loading="lazy";im.onerror=()=>{im.style.display="none"};s.appendChild(im)}
  else{const e=document.createElement("div");e.textContent=item.emoji||"🔫";s.appendChild(e)}
  const n=document.createElement("div");n.className="bs-name";n.textContent=item.name;s.appendChild(n);
  return s;
}
function getRarityColor(r){return{Обычный:"#b0b0b0",Необычный:"#60a5fa",Редкий:"#c084fc",Легендарный:"#fbbf24",Мифический:"#f87171"}[r]||"#fff"}
function markRarity(r,name){if(r==="Редкий")state.gotRare=true;if(r==="Легендарный")state.gotLegend=true;if(r==="Мифический")state.gotMythic=true;if(name==="Butterfly | Twilight")state.gotTwilight=true}
function markCaseOpened(k){if(k==="nameless")state.gotNameless=true}
function addHistory(item,caseName){
  state.history.unshift({name:item.name,rarity:item.rarity,price:item.price,emoji:item.emoji,img:item.img,caseName,time:Date.now()});
  if(state.history.length>50)state.history=state.history.slice(0,50);
  state.bestDrops.push({name:item.name,rarity:item.rarity,price:item.price,emoji:item.emoji,img:item.img,time:Date.now()});
  state.bestDrops.sort((a,b)=>b.price-a.price);state.bestDrops=state.bestDrops.slice(0,10);
}

function renderCases(){
  const el=document.getElementById("cases");el.innerHTML="";
  for(const key in CASES){
    const c=CASES[key];const locked=c.goldOnly && !state.goldPass;const isDeal=state.dailyDealCase===key && c.price>0;
    const div=document.createElement("div");
    let cls="case";if(key===selectedCase)cls+=" selected";if(c.price===0)cls+=" free";
    if(key==="origin")cls+=" origin";if(key==="nightmare")cls+=" nightmare";if(key==="nameless")cls+=" nameless";if(key==="gold")cls+=" gold-case";
    if(locked)cls+=" locked";if(isDeal)cls+=" daily-deal";
    div.className=cls;
    const iw=document.createElement("div");iw.className="case-img";
    if(c.caseImg){const im=document.createElement("img");im.src=c.caseImg;im.loading="lazy";im.onerror=()=>{iw.innerHTML=`<span class="case-emoji">${c.emoji}</span>`};iw.appendChild(im)}
    else iw.innerHTML=`<span class="case-emoji">${c.emoji}</span>`;

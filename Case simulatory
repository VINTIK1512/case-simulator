  const thr=document.getElementById("themeRow");
  if(thr && thr.children.length===0)THEMES.forEach(t=>{const b=document.createElement("button");b.className="theme-btn"+(state.settings.theme===t.id?" active":"");b.textContent=t.name;b.onclick=()=>{state.settings.theme=t.id;playClick();updateUI();save()};thr.appendChild(b)});
  else if(thr)THEMES.forEach((t,i)=>{if(thr.children[i])thr.children[i].classList.toggle("active",state.settings.theme===t.id)});
  const sr=document.getElementById("speedRow");
  if(sr && sr.children.length===0)[["fast","⚡ 3с"],["normal","🎯 7с"],["slow","🐢 10с"]].forEach(([k,l])=>{const b=document.createElement("button");b.className="speed-btn"+(state.settings.speed===k?" active":"");b.textContent=l;b.onclick=()=>{state.settings.speed=k;playClick();save();renderSettings()};sr.appendChild(b)});
  else if(sr){const k=["fast","normal","slow"];[...sr.children].forEach((b,i)=>b.classList.toggle("active",state.settings.speed===k[i]))}

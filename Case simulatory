function doTrade(){
  if(state.tradeSelected.length!==3){showToast("❌ Выбери 3");return}
  const myItems=state.inventory.filter(i=>state.tradeSelected.includes(i.uid));
  const myValue=myItems.reduce((s,i)=>s+i.price,0);
  const targetValue=myValue*(0.6+Math.random()*0.8);
  const botItems=[];let totalBot=0;
  const c=CASES.valor;let tries=0;
  while(totalBot<targetValue && tries<10 && botItems.length<3){
    const it={...pickItem(c)};
    if(totalBot+it.price<=targetValue*1.2){botItems.push(it);totalBot+=it.price}
    tries++;
  }
  if(botItems.length===0)botItems.push(pickItem(c));
  state.inventory=state.inventory.filter(i=>!state.tradeSelected.includes(i.uid));
  botItems.forEach(it=>{state.inventory.push({...it,uid:Date.now()+Math.random()});markRarity(it.rarity,it.name)});
  state.tradeCount++;state.tradeSelected=[];
  const diff=totalBot-myValue;
  showToast(diff>0?`✅ +${diff}`:`💱 ${diff}`);
  trackTask("trade1",1);addXP(10);
  document.getElementById("tradeResult").textContent=`${myValue} → ${totalBot} (${diff>=0?"+":""}${diff})`;
  document.getElementById("tradeResult").style.color=diff>=0?"#4ade80":"#f87171";
  updateUI();save();checkAchievements();
}


function sellItem(uid){
  initAudio();const i=state.inventory.findIndex(x=>x.uid===uid);if(i===-1)return;
  const it=state.inventory[i];const fp=state.goldPass?Math.floor(it.price*1.2):it.price;
  state.balance+=fp;state.sold++;state.inventory.splice(i,1);
  addTransaction(`Продал ${it.name}`,`+${fp}`);
  playTone(800,.1,"triangle",.1);showToast(`💵 +${fp}`);
  trackTask("sell5",1);trackQuest("sell5");addXP(2);
  if(state.dailyChallenge&&state.dailyChallenge.id==="sell10")trackChallenge(1);
  updateUI();save();checkAchievements();
}
function sellAll(){
  let items=state.inventory;if(state.invFilter!=="all")items=items.filter(i=>i.rarity===state.invFilter);
  if(items.length===0)return;
  initAudio();
  const base=items.reduce((s,i)=>s+i.price,0);

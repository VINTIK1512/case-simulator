function openBPModal(){
  playClick();
  const row=document.getElementById("bpRewardRow");if(!row)return;
  row.innerHTML="";
  BP_REWARDS.forEach(r=>{
    const unlocked=state.bpLevel>=r.lvl,claimed=state.bpClaimed.includes(r.lvl);
    const d=document.createElement("div");
    d.style.cssText="flex-shrink:0;width:75px;text-align:center;padding:6px;background:rgba(255,255,255,.05);border-radius:8px;font-size:9px;border:2px solid "+(claimed?"#f0c419":unlocked?"#4ade80":"#444");
    d.innerHTML=`<div style="font-size:20px">${r.icon}</div><div>Ур.${r.lvl}</div><div>${r.name}</div>${claimed?"<div>✅</div>":unlocked?"<div style='color:#4ade80;font-size:8px'>Забрать</div>":"<div>🔒</div>"}`;
    if(unlocked && !claimed)d.onclick=()=>claimBP(r.lvl);
    row.appendChild(d);
  });
  document.getElementById("bpModal").classList.add("show");
}
function claimBP(lvl){
  if(state.bpClaimed.includes(lvl))return;
  if(state.bpLevel<lvl)return;
  const r=BP_REWARDS.find(x=>x.lvl===lvl);if(!r)return;
  state.bpClaimed.push(lvl);
  if(r.type==="coins"){state.balance+=r.value;showToast(`🎖️ +${r.value}💰`)}
  else if(r.type==="frame"){state.profile.frame=r.value;showToast(`🎖️ Рамка`)}
  else if(r.type==="title"){state.profile.title=r.value;showToast(`🎖️ Титул`)}
  playTone(1200,.2,"triangle",.15);updateUI();save();openBPModal();
}

function renderBattleCases(){
  const el=document.getElementById("battleCaseRow");if(!el)return;el.innerHTML="";
  const av=Object.keys(CASES).filter(k=>!CASES[k].goldOnly || state.goldPass);
  av.forEach(k=>{
    const c=CASES[k];const b=document.createElement("button");
    b.className="bet-btn"+(k===selectedBattleCase?" active":"");b.textContent=c.emoji;
    b.onclick=()=>{selectedBattleCase=k;renderBattleCases()};el.appendChild(b);
  });
  const br=document.getElementById("betRow");
  if(br && !br.dataset.init){
    br.dataset.init="1";
    [100,500,1000,5000].forEach(a=>{
      const b=document.createElement("button");b.className="bet-btn"+(a===selectedBet?" active":"");b.textContent=a+"💰";
      b.onclick=()=>{selectedBet=a;renderBattleCases()};br.appendChild(b);
    });
  }else if(br)[...br.children].forEach(b=>{const a=parseInt(b.textContent);b.className="bet-btn"+(a===selectedBet?" active":"")});
}
async function startBattle(){
  if(isSpinning)return;initAudio();
  const c=CASES[selectedBattleCase];
  if(c.goldOnly && !state.goldPass){showToast("🔒 Голд Пасс!");return}
  if(state.balance<selectedBet){showToast("❌ Мало!");return}
  state.balance-=selectedBet;addTransaction("Баттл",`-${selectedBet}`);
  isSpinning=true;setButtonsDisabled(true);
  document.getElementById("battleResult").textContent="";
  const youWin=pickItem(c),botWin=pickItem(c);
  await spinRouletteOnce(c,youWin,"battleRoulette");
  const yp=youWin.price,bp=botWin.price;
  let text="";
  if(yp>bp){state.balance+=selectedBet*2;state.battleWins++;addTransaction("Баттл победа",`+${selectedBet*2}`);text=`🎉 Победа! +${selectedBet}`;showToast(`🏆 +${selectedBet}`);playTone(1000,.15,"triangle",.12);addXP(20);trackTask("battle1",1);trackQuest("battle1");if(state.dailyChallenge&&state.dailyChallenge.id==="battle3")trackChallenge(1);state.elo+=15;}
  else if(yp<bp){text=`😢 -${selectedBet}`;showToast("😢");playTone(200,.3,"sawtooth",.15);addXP(5);state.elo=Math.max(500,state.elo-10);}
  else{state.balance+=selectedBet;text=`🤝 Ничья`;showToast("🤝");addXP(10);}
  document.getElementById("battleResult").textContent=text;
  document.getElementById("battleResult").style.color=yp>bp?"#4ade80":yp<bp?"#f87171":"#fbbf24";
  updateUI();save();checkAchievements();
  isSpinning=false;setButtonsDisabled(false);
}

function renderAchievements(){
  const el=document.getElementById("achievements");if(!el)return;el.innerHTML="";
  ACHIEVEMENTS.forEach(a=>{
    const u=state.unlockedAchievements.includes(a.id);
    const d=document.createElement("div");d.className="achievement"+(u?" unlocked":"");
    d.innerHTML=`<b>${a.name}</b>${a.desc}<br><small>${u?"✅ +500💰":"🔒"}</small>`;
    el.appendChild(d);
  });
}
function checkAchievements(){
  ACHIEVEMENTS.forEach(a=>{
    if(!state.unlockedAchievements.includes(a.id) && a.check(state)){
      state.unlockedAchievements.push(a.id);
      state.balance+=500;addXP(50);
      showToast(`🏆 ${a.name} +500💰`);
      playTone(1000,.15,"triangle",.12);save();
    }
  });
  renderAchievements();
}

let toastT=null;
function showToast(t){
  if(!state.settings.notify)return;
  const x=document.getElementById("toast");x.textContent=t;x.classList.add("show");
  if(toastT)clearTimeout(toastT);
  toastT=setTimeout(()=>x.classList.remove("show"),2500);
}
function openGoldPassModal(){initAudio();playClick();if(state.goldPass){showToast("✅ Куплен!");return}document.getElementById("gpModal").classList.add("show")}
function closeGoldPassModal(){document.getElementById("gpModal").classList.remove("show")}
function buyGoldPass(){
  if(state.goldPass){closeGoldPassModal();return}
  if(state.balance<GOLDPASS_PRICE){showToast("❌ Нужно 5000");return}
  state.balance-=GOLDPASS_PRICE;state.goldPass=true;
  addTransaction("Голд Пасс",`-5000`);
  playTone(800,.15,"triangle",.12);
  setTimeout(()=>playTone(1300,.2,"triangle",.12),200);
  showToast("🏆 Голд Пасс!");
  closeGoldPassModal();updateUI();save();checkAchievements();
}

function doPrestige(){
  if(state.level<50){showToast("❌ Нужен 50 ур.");return}
  if(!confirm("Престиж? Сброс уровня и монет."))return;
  state.prestige++;state.level=1;state.xp=0;state.balance=5000;
  state.profile.frame="mythic";state.profile.title="Король мификов";
  showToast(`✨ ПРЕСТИЖ ${state.prestige}!`);
  playTone(1000,.2,"triangle",.15);
  updateUI();save();checkAchievements();
}

function exportSave(){
  const data=JSON.stringify(state);
  const blob=new Blob([data],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");a.href=url;a.download="standoff2_sim_save.json";a.click();
  URL.revokeObjectURL(url);showToast("📤 Скачано!");
}
function showImport(){document.getElementById("ioText").style.display="block";document.getElementById("doImportBtn").style.display="block"}
function doImport(){
  const t=document.getElementById("ioText").value.trim();
  if(!t){showToast("❌ Пусто!");return}
  try{const p=JSON.parse(t);state={...JSON.parse(JSON.stringify(DEFAULT_STATE)),...p};save();showToast("📥 OK!");setTimeout(()=>location.reload(),800)}
  catch(e){showToast("❌ Ошибка")}
}

function lsWorks(){try{const t="___t___";localStorage.setItem(t,"1");const v=localStorage.getItem(t);localStorage.removeItem(t);return v==="1"}catch(e){return false}}

function downloadSaveFile(){
  try{
    const data=JSON.stringify(state);
    const blob=new Blob([data],{type:"application/json"});
    const url=URL.createObjectURL(blob);
    const a=document.createElement("a");
    const d=new Date();
    const stamp=`${d.getFullYear()}-${(d.getMonth()+1).toString().padStart(2,"0")}-${d.getDate().toString().padStart(2,"0")}_${d.getHours().toString().padStart(2,"0")}-${d.getMinutes().toString().padStart(2,"0")}`;
    a.href=url;a.download=`standoff2_save_${stamp}.json`;
    document.body.appendChild(a);a.click();document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast("💾 Сохранение скачано!");
    setSaveStatus(true);
  }catch(e){showToast("❌ Не удалось скачать")}
}

function handleFileLoad(file){
  const reader=new FileReader();
  reader.onload=(e)=>{
    try{
      const parsed=JSON.parse(e.target.result);
      if(typeof parsed!=="object"||parsed===null)throw new Error("bad");
      state={...JSON.parse(JSON.stringify(DEFAULT_STATE)),...parsed};
      try{localStorage.setItem(LS_KEY,JSON.stringify(state))}catch(_){}
      idbSave(state);
      updateUI();
      showToast("📂 Сохранение загружено!");
      setSaveStatus(true);
    }catch(err){showToast("❌ Неверный файл")}
  };
  reader.readAsText(file);
}

function setSaveStatus(ok){
  const dot=document.getElementById("saveStatusDot");if(!dot)return;
  dot.style.background=ok?"#4ade80":"#f87171";
  dot.style.boxShadow="0 0 8px "+(ok?"#4ade80":"#f87171");
}

async function initSaveSystem(){
  const lsOK=lsWorks();
  await openIDB();
  if(!lsOK){
    console.warn("⚠️ localStorage НЕ работает! Используй кнопки 💾 и 📂");
    showToast("⚠️ Сохранение через файл!");
    setSaveStatus(false);
    const data=await idbLoad();
    if(data && !localStorage.getItem(LS_KEY)){
      state={...JSON.parse(JSON.stringify(DEFAULT_STATE)),...data};
      updateUI();
    }
  }else{
    setSaveStatus(true);
  }
  const dl=document.getElementById("dlSaveBtn");
  const up=document.getElementById("upSaveBtn");
  const fi=document.getElementById("upFileInput");
  if(dl)dl.onclick=downloadSaveFile;
  if(up)up.onclick=()=>fi.click();
  if(fi)fi.onchange=(e)=>{
    const f=e.target.files[0];
    if(f)handleFileLoad(f);
    e.target.value="";
  };
  setInterval(()=>{idbSave(state)},10*60*1000);
}

window.addEventListener("beforeunload",()=>{
  try{localStorage.setItem(LS_KEY,JSON.stringify(state))}catch(e){}
  idbSave(state);
});

function safeBind(id, handler){
  const el=document.getElementById(id);
  if(el)el.onclick=handler;
  else console.warn("Элемент не найден:", id);
}


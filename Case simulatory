  const qf=[];for(let i=0;i<8;i+=2){const a={...players[i],price:pickItem(c).price},b={...players[i+1],price:pickItem(c).price};qf.push({a,b,winner:a.price>=b.price?0:1})}
  rounds.push(qf);
  const sf=[];for(let i=0;i<4;i+=2){const wa=qf[i].winner===0?qf[i].a:qf[i].b,wb=qf[i+1].winner===0?qf[i+1].a:qf[i+1].b;const a={...wa,price:pickItem(c).price},b={...wb,price:pickItem(c).price};sf.push({a,b,winner:a.price>=b.price?0:1})}
  rounds.push(sf);
  const fa=sf[0].winner===0?sf[0].a:sf[0].b,fb=sf[1].winner===0?sf[1].a:sf[1].b;
  const fA={...fa,price:pickItem(c).price},fB={...fb,price:pickItem(c).price};
  const final={a:fA,b:fB,winner:fA.price>=fB.price?0:1};
  rounds.push([final]);
  state.tournament={rounds};renderTournament();
  await new Promise(r=>setTimeout(r,1500));
  const winnerName=final.winner===0?fA.name:fB.name;
  if(winnerName===state.profile.name){state.balance+=3000;state.tournamentWins++;addTransaction("Турнир победа",`+3000`);showToast("🏆 ЧЕМПИОН! +3000");addXP(50)}
  else showToast(`😢 Победил ${winnerName}`);
  updateUI();save();checkAchievements();
  isSpinning=false;setButtonsDisabled(false);
}


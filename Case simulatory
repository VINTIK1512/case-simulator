<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Кейс Симулятор Ultimate</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:linear-gradient(135deg,#1a1a2e,#16213e,#0f3460);--card:rgba(255,255,255,.08);--accent:#f0c419;--text:#fff}
body[data-theme="light"]{--bg:linear-gradient(135deg,#e0e7ff,#f5f3ff,#fef3c7);--card:rgba(0,0,0,.06);--accent:#d97706;--text:#1a1a2e}
body[data-theme="neon"]{--bg:linear-gradient(135deg,#0a001a,#1a0033,#001a1a);--card:rgba(255,0,255,.08);--accent:#00ffff;--text:#f0f0f0}
body[data-theme="retro"]{--bg:linear-gradient(135deg,#3a1a00,#5a2a00,#1a0a00);--card:rgba(255,200,100,.1);--accent:#ffb000;--text:#ffe0b0}
body{font-family:'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;padding:12px;user-select:none;padding-bottom:80px;overflow-x:hidden;transition:background .5s}
#startScreen{position:fixed;inset:0;z-index:5000;background:radial-gradient(ellipse at center,#1a1a2e 0%,#0a0a14 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;transition:opacity .5s}
#startScreen.hidden{opacity:0;pointer-events:none}
.start-logo{font-size:60px;margin-bottom:6px;animation:bounce 2s ease-in-out infinite alternate}
@keyframes bounce{from{transform:translateY(0)}to{transform:translateY(-10px) scale(1.05)}}
.start-title{font-size:26px;font-weight:bold;color:#f0c419;text-shadow:0 0 20px rgba(240,196,25,.8);letter-spacing:3px;margin-bottom:4px}
.start-subtitle{font-size:11px;color:#aaa;letter-spacing:4px;margin-bottom:40px;text-transform:uppercase}
.start-buttons{display:flex;flex-direction:column;gap:10px;width:100%;max-width:300px;z-index:2}
.start-btn{padding:14px 20px;font-size:15px;font-weight:bold;border:2px solid rgba(255,255,255,.15);border-radius:14px;background:rgba(255,255,255,.05);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px}
.start-btn.play{background:linear-gradient(135deg,#f0c419,#e0a800);color:#1a1a2e;border:none;font-size:20px;padding:18px 20px;box-shadow:0 8px 30px rgba(240,196,25,.5);animation:playPulse 2s infinite alternate}
@keyframes playPulse{from{box-shadow:0 8px 30px rgba(240,196,25,.5)}to{box-shadow:0 8px 50px rgba(240,196,25,.9)}}
.menu-modal{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:5100;display:none;align-items:center;justify-content:center;padding:20px;overflow-y:auto}
.menu-modal.show{display:flex}
.menu-modal-content{background:linear-gradient(135deg,#2a2a4a,#1a1a2e);border:2px solid #f0c419;border-radius:16px;padding:20px;max-width:420px;width:100%;max-height:90vh;overflow-y:auto}
.menu-modal-content h2{color:#f0c419;font-size:18px;margin-bottom:12px;text-align:center}
.menu-modal-content p{font-size:12px;color:#ccc;line-height:1.6;margin-bottom:10px}
.menu-modal-close{width:100%;padding:12px;font-size:13px;font-weight:bold;border:none;border-radius:10px;background:linear-gradient(135deg,#f0c419,#e0a800);color:#1a1a2e;cursor:pointer;margin-top:12px}
.menu-stat-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:12px}
.menu-stat-row span:last-child{color:#4ade80;font-weight:bold}
h1{text-align:center;font-size:17px;margin-bottom:6px;color:var(--accent);text-shadow:0 0 10px rgba(240,196,25,.5)}
.top-bar{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:5px;margin-bottom:6px}
.stat{text-align:center;background:var(--card);padding:5px 3px;border-radius:10px;font-size:9px}
.stat b{display:block;font-size:12px;margin-top:2px}
.stat.money b{color:#4ade80}.stat.opened b{color:#60a5fa}.stat.level b{color:var(--accent)}.stat.xp b{color:#c084fc}
.xp-bar{grid-column:1/-1;background:rgba(0,0,0,.4);height:5px;border-radius:6px;overflow:hidden}
.xp-fill{height:100%;background:linear-gradient(90deg,#c084fc,var(--accent));transition:width .4s;width:0%}
.event-bar{background:linear-gradient(90deg,#7c2d12,#dc2626,#7c2d12);border-radius:10px;padding:6px 10px;margin-bottom:6px;display:none;align-items:center;gap:8px;border:2px solid #f59e0b}
.event-bar.show{display:flex}
.ev-icon{font-size:18px}.ev-text{flex:1;font-size:11px;font-weight:bold}
.goldpass-bar{background:linear-gradient(90deg,#4a3a00,#b8860b,#ffd700,#b8860b,#4a3a00);background-size:200% 100%;animation:shine 3s linear infinite;border-radius:10px;padding:6px 10px;margin-bottom:6px;display:flex;align-items:center;gap:8px;border:2px solid #ffd700;cursor:pointer}
@keyframes shine{0%{background-position:0% 50%}100%{background-position:200% 50%}}
.gp-icon{font-size:20px}.gp-info{flex:1}.gp-info h3{font-size:11px;margin-bottom:1px}.gp-info p{font-size:9px;color:#ffeaa7}.gp-status{font-size:14px}
.daily-bar{background:linear-gradient(90deg,#166534,#22c55e,#166534);border-radius:10px;padding:6px 10px;margin-bottom:6px;display:flex;align-items:center;gap:8px;border:2px solid #22c55e;cursor:pointer}
.bp-bar{background:linear-gradient(90deg,#4c1d95,#a855f7,#4c1d95);border-radius:10px;padding:6px 10px;margin-bottom:8px;display:flex;align-items:center;gap:8px;border:2px solid #a855f7;cursor:pointer;position:relative;overflow:hidden}
.bp-bar::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent);animation:bpShine 2s infinite}
@keyframes bpShine{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}
.db-icon,.bp-icon{font-size:16px}.db-info,.bp-info{flex:1}.db-info h3,.bp-info h3{font-size:10px;margin-bottom:1px}.db-info p,.bp-info p{font-size:9px}.db-status,.bp-status{font-size:12px;font-weight:bold}
.tabs{display:flex;gap:3px;margin-bottom:8px;background:rgba(0,0,0,.3);padding:3px;border-radius:10px;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{flex:1;min-width:44px;text-align:center;padding:6px 2px;font-size:9px;border-radius:8px;cursor:pointer;color:#aaa;white-space:nowrap}
.tab.active{background:var(--accent);color:#1a1a2e;font-weight:bold}
.page{display:none}.page.active{display:block}
.cases{display:grid;grid-template-columns:1fr;gap:5px;margin-bottom:8px}
.case{background:linear-gradient(135deg,#2a2a4a,#1a1a3a);border:2px solid #444;border-radius:10px;padding:5px;cursor:pointer;position:relative;overflow:hidden;display:flex;align-items:center;gap:8px}
.case.selected{border-color:var(--accent);box-shadow:0 0 12px rgba(240,196,25,.4)}
.case.free::before{content:'FREE';position:absolute;top:4px;right:-20px;background:#4ade80;color:#000;font-size:7px;font-weight:bold;padding:2px 20px;transform:rotate(35deg)}
.case.origin{background:linear-gradient(135deg,#3a1a2a,#1a0a1a);border-color:#ef4444}
.case.nightmare{background:linear-gradient(135deg,#2a0a3a,#0a001a);border-color:#a855f7}
.case.nameless{background:linear-gradient(135deg,#1a1a2a,#0a0a1a);border-color:#6b7280}
.case.gold-case{background:linear-gradient(135deg,#3a2e0a,#1a1500);border-color:#ffd700}
.case.daily-deal{border-color:#fbbf24;box-shadow:0 0 15px rgba(251,191,36,.6)}
.case.locked{opacity:.55;cursor:not-allowed;filter:grayscale(.5)}
.case .lock-badge{position:absolute;top:50%;right:6px;transform:translateY(-50%);font-size:16px}
.case .deal-badge{position:absolute;top:2px;left:2px;background:#fbbf24;color:#000;font-size:8px;font-weight:bold;padding:2px 5px;border-radius:5px}
.case-img{width:46px;height:46px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.3);border-radius:8px;overflow:hidden}
.case-img img{width:100%;height:100%;object-fit:contain;padding:3px}
.case-emoji{font-size:24px}
.case-info{flex:1}.case-info h3{font-size:12px;margin-bottom:1px}.case-info p{font-size:9px;color:#aaa}
.roulette-wrapper{margin:8px 0}
.roulette-container{background:#0a0a0a;border-radius:10px;overflow:hidden;position:relative;height:90px;border:2px solid #333;box-shadow:inset 0 0 60px rgba(0,0,0,.95)}
.roulette-container::before,.roulette-container::after{content:'';position:absolute;top:0;bottom:0;width:70px;z-index:3;pointer-events:none}
.roulette-container::before{left:0;background:linear-gradient(90deg,rgba(0,0,0,.98),transparent)}
.roulette-container::after{right:0;background:linear-gradient(-90deg,rgba(0,0,0,.98),transparent)}
.roulette{display:flex;height:100%;will-change:transform}
.slot{min-width:80px;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;border-right:1px solid rgba(255,255,255,.06);font-size:9px;text-align:center;padding:4px;position:relative}
.slot::after{content:'';position:absolute;left:0;right:0;bottom:0;height:3px}
.slot.rarity-Обычный::after{background:#6b7280}.slot.rarity-Необычный::after{background:#3b82f6}.slot.rarity-Редкий::after{background:#a855f7}.slot.rarity-Легендарный::after{background:#f59e0b}.slot.rarity-Мифический::after{background:#ef4444}
.gun-image{width:58px;height:32px;display:flex;align-items:center;justify-content:center;margin-bottom:2px}
.gun-image img{max-width:100%;max-height:100%;object-fit:contain}
.gun-emoji{font-size:18px}
.slot .name{font-weight:bold;font-size:8px;line-height:1.1;margin-bottom:2px}
.slot .rarity-label{font-size:7px;opacity:.8}
.pointer{position:absolute;top:0;bottom:0;left:50%;width:2px;background:#ffe066;transform:translateX(-50%);z-index:5;box-shadow:0 0 15px #ffe066}
.pointer::before,.pointer::after{content:'';position:absolute;left:50%;transform:translateX(-50%);border:6px solid transparent}
.pointer::before{top:-6px;border-top-color:#ffe066}.pointer::after{bottom:-6px;border-bottom-color:#ffe066}
.roulette-container.spinning .pointer{animation:pulse .4s infinite alternate}
@keyframes pulse{from{box-shadow:0 0 12px #ffe066}to{box-shadow:0 0 30px #ffe066}}
.roulette-container.win-flash{animation:winFlash .8s}
@keyframes winFlash{0%{box-shadow:inset 0 0 60px rgba(0,0,0,.95)}30%{box-shadow:inset 0 0 100px rgba(255,224,102,.8)}100%{box-shadow:inset 0 0 60px rgba(0,0,0,.95)}}
.win-popup{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(0);z-index:10;padding:6px 14px;border-radius:10px;font-weight:bold;font-size:11px;text-align:center;animation:popIn .6s cubic-bezier(.34,1.56,.64,1) forwards;pointer-events:none;border:2px solid rgba(255,255,255,.3)}
.win-popup img{width:70px;height:40px;object-fit:contain}
@keyframes popIn{0%{transform:translate(-50%,-50%) scale(0) rotate(-10deg)}100%{transform:translate(-50%,-50%) scale(1) rotate(0)}}
.rarity-Обычный{background:#2c2c2c;color:#b0b0b0}.rarity-Необычный{background:#1e3a5f;color:#60a5fa}.rarity-Редкий{background:#3a1e5f;color:#c084fc}.rarity-Легендарный{background:#4a3a1a;color:#fbbf24}.rarity-Мифический{background:#5f1e1e;color:#f87171}
.open-buttons{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr;gap:3px;margin-bottom:6px}
button.open-btn-main{padding:10px 4px;font-size:11px;font-weight:bold;border:none;border-radius:10px;background:linear-gradient(135deg,var(--accent),#e0a800);color:#1a1a2e;cursor:pointer}
button.open-btn-multi{padding:10px 2px;font-size:10px;font-weight:bold;border:2px solid var(--accent);border-radius:10px;background:rgba(240,196,25,.15);color:var(--accent);cursor:pointer}
button.open-btn-ultra{padding:10px 2px;font-size:9px;font-weight:bold;border:2px solid #c084fc;border-radius:10px;background:rgba(192,132,252,.15);color:#c084fc;cursor:pointer}
button:disabled{opacity:.4;cursor:not-allowed}
.auto-btn{width:100%;padding:8px;margin-bottom:6px;font-size:10px;font-weight:bold;border:2px dashed #c084fc;background:rgba(192,132,252,.1);color:#c084fc;border-radius:10px;cursor:pointer}
.auto-btn.active{background:#c084fc;color:#000;border-style:solid}
.result{text-align:center;margin-top:3px;font-size:12px;min-height:16px;font-weight:bold}
.multi-progress{text-align:center;font-size:10px;color:var(--accent);margin-top:3px;min-height:12px;font-weight:bold}
.pity-indicator{text-align:center;font-size:9px;color:#c084fc;margin-top:3px;min-height:10px}
.multi-history{display:flex;gap:3px;justify-content:center;flex-wrap:wrap;margin-top:4px;min-height:30px}
.multi-history .mini-drop{width:30px;height:30px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:12px;border:2px solid rgba(255,255,255,.2)}
.multi-history .mini-drop img{width:100%;height:100%;object-fit:contain;padding:2px}
.inv-filters{display:flex;gap:3px;margin-bottom:6px;flex-wrap:wrap}
.inv-filter{padding:4px 6px;font-size:9px;border:1px solid #555;background:rgba(255,255,255,.05);color:#ccc;border-radius:6px;cursor:pointer}
.inv-filter.active{background:var(--accent);color:#1a1a2e;border-color:var(--accent);font-weight:bold}
.inv-item{display:flex;justify-content:space-between;align-items:center;font-size:10px;padding:4px 6px;margin-bottom:3px;border-radius:8px;gap:5px}
.inv-item .inv-name{flex:1;display:flex;align-items:center;gap:5px}
.inv-item .inv-img{width:40px;height:24px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.inv-item .inv-img img{max-width:100%;max-height:100%;object-fit:contain}
.inv-item .sell-btn{background:#4ade80;color:#000;border:none;padding:3px 6px;font-size:9px;font-weight:bold;border-radius:5px;cursor:pointer}
.inventory-empty{font-size:10px;color:#888;text-align:center;padding:20px}
.sell-all{width:100%;padding:7px;margin-bottom:5px;background:#f87171;color:#fff;border:none;border-radius:8px;font-weight:bold;font-size:10px;cursor:pointer}
.upgrade-panel{background:var(--card);border-radius:12px;padding:10px;margin-bottom:10px}
.upgrade-info-row{display:flex;justify-content:space-between;font-size:11px;padding:4px 0;border-bottom:1px solid rgba(255,255,255,.08)}
.upgrade-info-row b{color:var(--accent)}
.upgrade-chance-bar{height:8px;background:rgba(0,0,0,.5);border-radius:6px;overflow:hidden;margin:8px 0}
.upgrade-chance-fill{height:100%;background:linear-gradient(90deg,#ef4444,#fbbf24,#4ade80);transition:width .5s;width:0%}
.upgrade-arena{display:flex;flex-direction:column;align-items:center;gap:14px;padding:10px 0}
.upgrade-slots{display:flex;gap:8px;justify-content:center;align-items:center;flex-wrap:wrap}
.upgrade-slot{width:62px;height:46px;background:rgba(0,0,0,.4);border:2px dashed #555;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:22px;position:relative;cursor:pointer}
.upgrade-slot.filled{border-style:solid;border-color:var(--accent);background:rgba(240,196,25,.1)}
.upgrade-slot img{max-width:100%;max-height:100%;object-fit:contain;padding:3px}
.upgrade-slot .remove-x{position:absolute;top:-6px;right:-6px;width:18px;height:18px;background:#ef4444;color:#fff;border-radius:50%;font-size:11px;font-weight:bold;display:flex;align-items:center;justify-content:center;cursor:pointer;line-height:1}
.upgrade-arrow{font-size:24px;color:var(--accent)}
.upgrade-wheel-wrap{position:relative;width:220px;height:220px;margin:8px auto}
.upgrade-wheel{width:100%;height:100%;border-radius:50%;border:6px solid #1a1a2e;box-shadow:0 0 30px rgba(0,0,0,.7),inset 0 0 40px rgba(0,0,0,.6),0 0 0 3px var(--accent);position:relative;overflow:hidden;transition:transform 5s cubic-bezier(.15,.9,.25,1);background:conic-gradient(#166534 0deg 60deg,#7f1d1d 60deg 120deg,#166534 120deg 180deg,#7f1d1d 180deg 240deg,#166534 240deg 300deg,#7f1d1d 300deg 360deg)}
.upgrade-wheel-center{position:absolute;top:50%;left:50%;width:52px;height:52px;background:linear-gradient(135deg,#2a2a4a,#0f0f1e);border-radius:50%;transform:translate(-50%,-50%);border:3px solid var(--accent);display:flex;align-items:center;justify-content:center;z-index:3;font-size:22px}
.upgrade-wheel-center img{max-width:80%;max-height:80%;object-fit:contain}
.upgrade-wheel-pointer{position:absolute;top:-14px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:12px solid transparent;border-right:12px solid transparent;border-top:22px solid var(--accent);z-index:5;filter:drop-shadow(0 0 8px var(--accent))}
.upgrade-status{text-align:center;font-size:12px;font-weight:bold;min-height:18px}
.upgrade-picker{max-height:240px;overflow-y:auto;margin-bottom:10px}
.upgrade-pick-item{display:flex;align-items:center;gap:8px;padding:6px 8px;background:rgba(255,255,255,.05);border-radius:8px;margin-bottom:4px;font-size:10px;cursor:pointer;border:2px solid transparent}
.upgrade-pick-item.selected{border-color:var(--accent);background:rgba(240,196,25,.15)}
.upgrade-pick-item.disabled{opacity:.3;cursor:not-allowed}
.upgrade-pick-item .up-img{width:42px;height:24px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.upgrade-pick-item .up-img img{max-width:100%;max-height:100%;object-fit:contain}
.upgrade-pick-item .up-info{flex:1}
.upgrade-pick-item .up-price{color:#4ade80;font-weight:bold;font-size:10px}
.upgrade-go-btn{width:100%;padding:12px;font-size:13px;font-weight:bold;border:none;border-radius:10px;background:linear-gradient(135deg,#a855f7,#7c3aed);color:#fff;cursor:pointer}
.upgrade-go-btn:disabled{background:#444;color:#888;cursor:not-allowed}
.upgrade-result{text-align:center;font-size:13px;font-weight:bold;min-height:20px;padding:8px;border-radius:10px;margin-top:8px}
.upgrade-result.win{background:rgba(74,222,128,.2);color:#4ade80}
.upgrade-result.lose{background:rgba(239,68,68,.2);color:#f87171}
.upgrade-win-popup{position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:1700;display:none;align-items:center;justify-content:center;padding:20px}
.upgrade-win-popup.show{display:flex}
.upgrade-win-content{background:linear-gradient(135deg,#2a2a4a,#1a1a2e);border:3px solid #4ade80;border-radius:20px;padding:24px;text-align:center;max-width:340px;width:100%}
.upgrade-win-content img{width:200px;height:120px;object-fit:contain;margin:10px 0}
.upgrade-win-content h3{color:#4ade80;font-size:20px;margin-bottom:6px}
.upgrade-win-content button{width:100%;padding:12px;font-size:14px;font-weight:bold;border:none;border-radius:10px;background:linear-gradient(135deg,#4ade80,#16a34a);color:#000;cursor:pointer;margin-top:8px}
.mg-tabs{display:flex;gap:4px;margin-bottom:8px;flex-wrap:wrap}
.mg-tab{flex:1;min-width:60px;padding:7px;font-size:10px;font-weight:bold;border:2px solid #444;background:rgba(255,255,255,.05);color:#aaa;border-radius:8px;cursor:pointer;text-align:center}
.mg-tab.active{border-color:var(--accent);background:rgba(240,196,25,.15);color:var(--accent)}
.mg-panel{display:none}.mg-panel.active{display:block}
.section-header{background:var(--card);border-radius:10px;padding:8px;margin-bottom:8px;font-size:10px;color:#aaa;line-height:1.4}
.section-header h3{font-size:12px;color:var(--accent);margin-bottom:4px}
.bet-btn{flex:1;min-width:50px;padding:6px;font-size:9px;font-weight:bold;border:2px solid var(--accent);background:rgba(240,196,25,.1);color:var(--accent);border-radius:8px;cursor:pointer;margin:2px}
.bet-btn.active{background:var(--accent);color:#1a1a2e}
.battle-row{display:flex;gap:4px;margin-bottom:6px;flex-wrap:wrap}
.jackpot-wheel{width:200px;height:200px;border-radius:50%;margin:10px auto;position:relative;border:4px solid var(--accent);transition:transform 4s cubic-bezier(.15,.9,.25,1);background:conic-gradient(#4ade80 0deg 45deg,#ef4444 45deg 90deg,#60a5fa 90deg 135deg,#a855f7 135deg 180deg,#fbbf24 180deg 225deg,#f87171 225deg 270deg,#22c55e 270deg 315deg,#ffd700 315deg 360deg)}
.mines-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:10px auto;max-width:340px}
.mine-cell{aspect-ratio:1;background:linear-gradient(135deg,#2a2a4a,#1a1a3a);border:2px solid #555;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:22px;cursor:pointer}
.mine-cell.safe{background:linear-gradient(135deg,#166534,#14532d);border-color:#4ade80;cursor:default}
.mine-cell.bomb{background:linear-gradient(135deg,#7f1d1d,#450a0a);border-color:#ef4444;cursor:default}
.mine-cell.disabled{cursor:not-allowed}
.mines-info{text-align:center;margin-bottom:8px;font-size:11px}
.crash-display{background:#0a0a0a;border:2px solid #333;border-radius:12px;height:170px;margin:10px 0;display:flex;align-items:center;justify-content:center}
.crash-mult{font-size:44px;font-weight:bold;color:#4ade80}
.crash-mult.crashed{color:#ef4444}
.mines-btn,.crash-btn,.battle-btn{flex:1;padding:10px;font-size:11px;font-weight:bold;border:none;border-radius:10px;cursor:pointer}
.mines-start,.crash-start{background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff}
